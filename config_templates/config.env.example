# Nöbetçi configuration. Keep this file root-only: chmod 600 /etc/nobetci/config.env

# Telegram (create a bot with @BotFather, get your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Bot language: tr or en
LANG="tr"

# This server's public IP and any address that must never be banned (comma separated, CIDR allowed)
SERVER_IP=""
WHITELIST=""

# AI: groq | ollama | openai (any OpenAI-compatible endpoint via AI_BASE_URL)
AI_PROVIDER="groq"
AI_API_KEY=""
AI_BASE_URL=""
AI_MODELS="moonshotai/kimi-k2-instruct,llama-3.3-70b-versatile,llama-3.1-8b-instant"
AI_TIME_BUDGET="75"
# Answer non-command messages with the AI (on/off)
AI_CHAT="on"

# Trap URLs: any request to these paths bans the IP at once.
# Never list a path your site really serves. Not running WordPress? Add /wp-login.php,/xmlrpc.php
TRAP_PATHS="/.env,/.git/config,/.aws/credentials,/phpinfo.php,/wp-config.php.bak"
TRAP_BAN="30d"

# Optional: also block at Cloudflare's edge (token with Zone > Firewall Services > Edit)
CF_API_TOKEN=""
CF_ZONE_ID=""
CF_ACCOUNT_ID=""

# Paths
DB_PATH="/var/lib/nobetci/nobetci.db"
STATE_DIR="/var/lib/nobetci"
NGINX_ACCESS_LOG="/var/log/nginx/access.log"
NGINX_ERROR_LOG="/var/log/nginx/error.log"
AUTH_LOG="/var/log/auth.log"
BLOCKLIST_PATH="/etc/nginx/snippets/blocked-ips.conf"
